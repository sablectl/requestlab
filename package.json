{
  "name": "requestlab",
  "version": "1.0.0",
  "description": "HTTP Inspection and Debugging Toolkit — request execution, response inspection and response comparison for the command line.",
  "type": "module",
  "license": "MIT",
  "author": "Sable <355646062+sablectl@users.noreply.github.com>",
  "homepage": "https://github.com/sablectl/requestlab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sablectl/requestlab.git"
  },
  "bugs": {
    "url": "https://github.com/sablectl/requestlab/issues"
  },
  "keywords": [
    "cli",
    "http",
    "debugging",
    "inspection",
    "api",
    "developer-tools",
    "typescript"
  ],
  "bin": {
    "requestlab": "./dist/bin/requestlab.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run test:integration && npm run build"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
